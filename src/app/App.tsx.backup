import { useState, useEffect } from 'react';
import { Menu, X, Phone, MessageCircle, Mail, MapPin, Facebook, Instagram, Monitor, Camera, Fingerprint, Server, HardDrive, ChevronRight, Star, Shield, Clock, Award, Users, Zap, CheckCircle, ArrowRight, Laptop, Wifi, Database, Plus, Minus } from 'lucide-react';
